---
import type { ReviewProps } from '../../layouts/Review.astro'

type Props = ReviewProps
const { title, author, description, publishYear, publishedAt, rating } = Astro.props
const pageUrl = new URL(Astro.url.pathname, Astro.site)

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  url: pageUrl,
  datePublished: publishedAt,
  description,
  itemReviewed: {
    '@type': 'Book',
    name: title,
    author: {
      '@type': 'Person',
      name: author
    },
    datePublished: publishYear
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: rating,
    bestRating: 5,
    worstRating: 1
  },
  author: {
    '@type': 'Person',
    name: 'Rayhan',
    url: Astro.site
  }
}
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

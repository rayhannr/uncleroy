---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatLongDate } from '../../utils/date'
import { getReadingTime } from '../../utils/readingTime'
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import BlogStructuredData from '../../components/structured-data/BlogStructuredData.astro'

export async function getStaticPaths() {
  const blogs = await getCollection('blogs')
  const published = blogs
    .filter((blog) => blog.data.status === 'published')
    .sort((a, b) => a.data.publishedAt!.valueOf() - b.data.publishedAt!.valueOf())
  return blogs.map((blog) => {
    const index = published.findIndex((p) => p.id === blog.id)
    return {
      params: { slug: blog.id },
      props: {
        blog,
        prev: index > 0 ? published[index - 1] : undefined,
        next: index >= 0 ? published[index + 1] : undefined
      }
    }
  })
}

const { blog, prev, next } = Astro.props

if (!blog) {
  return Astro.redirect('/404')
}

const { title, image, imageCaption, imageCredit, imageLink, publishedAt, description, metaDescription, status } = blog.data
const { Content } = await render(blog)
// KaTeX styles and fonts are self-hosted in public/katex and only loaded for posts that use $$ math.
const hasMath = blog.body?.includes('$$') ?? false
---

<BaseLayout {title} description={metaDescription || description} image={image.src} showMeter>
  <BlogStructuredData slot="structured-data" {...blog.data} />
  {hasMath && <link slot="head" rel="stylesheet" href="/katex/katex.min.css" />}
  <article class="mt-2 lg:mt-4">
    <header>
      <h1 class="font-semibold text-balance">
        {title}
      </h1>

      {publishedAt && (
        <time datetime={publishedAt.toISOString()} class="block mb-4 text-neutral-500 dark:text-neutral-400">
          <div class="flex flex-col sm:flex-row gap-x-3 gap-y-1 leading-tight text-sm">
            <span>{formatLongDate(publishedAt)}</span>
            <span class="hidden sm:inline-block">|</span>
            <span>{getReadingTime(blog.body || '')}</span>
          </div>
        </time>
      )}

      <figure class="mt-6 font-normal text-balance">
        <a href={image.src} target="_blank">
          <Image
            src={image}
            alt={imageCaption}
            width={1900}
            height={900}
            class="mb-1 rounded w-full aspect-[11/5] object-cover"
            loading="eager"
          />
        </a>
        <figcaption class="text-xs text-neutral-500 dark:text-neutral-400 text-center">
          Background image by <a href={imageLink} class="text-neutral-700 dark:text-neutral-200" target="_blank">
            {imageCredit}
          </a> from Unsplash
        </figcaption>
      </figure>
    </header>

    <div class="mt-8">
      {status === 'draft' ? <p>Regrettably, the material is still in its draft stage.</p> : <Content />}
    </div>

    {(prev || next) && (
      <nav aria-label="More posts" class="mt-12 mb-8 grid gap-6 sm:gap-4 sm:grid-cols-2 text-sm">
        {prev ? (
          <a href={`/blog/${prev.id}`} aria-label={`Previous post: ${prev.data.title}`} class="group flex items-center gap-3">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 transition-transform group-hover:-translate-x-1">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span>
              <span class="block font-semibold text-balance">{prev.data.title}</span>
            </span>
          </a>
        ) : <span class="hidden sm:block" />}
        {next && (
          <a href={`/blog/${next.id}`} aria-label={`Next post: ${next.data.title}`} class="group flex flex-row-reverse items-center justify-end gap-3 sm:flex-row sm:text-right">
            <span>
              <span class="block font-semibold text-balance">{next.data.title}</span>
            </span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 transition-transform group-hover:translate-x-1">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
